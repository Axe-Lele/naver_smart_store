{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(rg:*)",
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(cat README.md)",
      "Bash(npm run typecheck)",
      "Bash(npm run extension:build)",
      "Bash(npm run desktop:build)"
    ],
    "deny": [
      "Bash(git reset --hard*)",
      "Bash(git checkout --*)",
      "Bash(git clean -f*)",
      "Bash(git push --force*)",
      "Bash(rm -rf .*)",
      "Bash(rm -rf *)",
      "Bash(del /f /s /q *)",
      "Bash(rmdir /s /q *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .codex/hooks/pre-bash-safety.cjs"
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "node .codex/hooks/pre-read-sensitive.cjs"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node .codex/hooks/pre-edit-config-guard.cjs"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .codex/hooks/stop-smart-store-review.cjs"
          }
        ]
      }
    ]
  },
  "env": {
    "SMART_STORE_RUNTIME": "Electron+React+Playwright+ChromeExtension",
    "SMART_STORE_OPERATOR_APP": "Wishfigure Seller Desk"
  }
}
