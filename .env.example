SMARTSTORE_PRODUCTS_URL=https://sell.smartstore.naver.com/
SMARTSTORE_LOGIN_MODE=storageState
SMARTSTORE_STORAGE_STATE_PATH=.\.auth\smartstore-storage-state.json
SMARTSTORE_USER_DATA_DIR=.\.auth\chrome-profile
SMARTSTORE_CHROME_CHANNEL=chrome
SMARTSTORE_EXECUTABLE_PATH=
SMARTSTORE_HEADLESS=false
SMARTSTORE_TIMEOUT_MS=20000
SMARTSTORE_NAVIGATION_TIMEOUT_MS=45000
SMARTSTORE_OUTPUT_DIR=.\output
SMARTSTORE_CONSECUTIVE_FAILURE_LIMIT=20
SMARTSTORE_CAPTURE_SCREENSHOT_ON_FAILURE=true
SMARTSTORE_CAPTURE_HTML_ON_FAILURE=true
SMARTSTORE_DEFAULT_DELAY_MS=1500
