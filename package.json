{
  "name": "smart-store",
  "version": "2.0.0",
  "description": "Electron desktop operator for setting Smart Store bundle-delivery scoped products as preorder products through the seller center UI.",
  "main": "dist/apps/desktop-electron/main/main.cjs",
  "type": "module",
  "private": true,
  "scripts": {
    "brand:assets": "powershell -ExecutionPolicy Bypass -File scripts/generate-brand-assets.ps1",
    "extension:build": "node scripts/build-chrome-extension.mjs",
    "extension:typecheck": "tsc -p apps/chrome-extension/tsconfig.build.json --noEmit",
    "extension:lint": "eslint \"apps/chrome-extension/src/**/*.ts\"",
    "desktop:dev": "npm run extension:build && set \"ELECTRON_RUN_AS_NODE=\" && electron-vite dev --config apps/desktop-electron/electron.vite.config.ts",
    "desktop:build": "npm run extension:build && set \"ELECTRON_RUN_AS_NODE=\" && electron-vite build --config apps/desktop-electron/electron.vite.config.ts",
    "desktop:preview": "npm run extension:build && set \"ELECTRON_RUN_AS_NODE=\" && electron-vite preview --config apps/desktop-electron/electron.vite.config.ts",
    "desktop:prepare-runtime": "node scripts/prepare-playwright-runtime.mjs",
    "release:package": "node scripts/package-release.mjs",
    "desktop:dist": "npm run brand:assets && npm run extension:build && npm run desktop:prepare-runtime && npm run desktop:build && electron-builder --win nsis && npm run release:package",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck",
    "verify:desktop": "npm run typecheck && npm run desktop:build",
    "verify:extension": "npm run extension:typecheck && npm run extension:build",
    "verify:release": "npm run typecheck && npm run desktop:dist"
  },
  "keywords": [
    "playwright",
    "typescript",
    "smartstore"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "fast-csv": "^5.0.5",
    "playwright": "^1.56.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.29",
    "@types/node": "^25.5.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.46.1",
    "@typescript-eslint/parser": "^8.46.1",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^41.2.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "eslint": "^8.57.1",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "rcedit": "^5.0.2",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vite": "^7.3.2",
    "vitest": "^3.2.4"
  },
  "build": {
    "appId": "com.smartstore.desktopoperator",
    "productName": "Wishfigure Seller Desk",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/apps/desktop-electron/**/*",
      "package.json",
      "node_modules/**/*",
      "!apps{,/**}",
      "!packages{,/**}",
      "!src{,/**}",
      "!tests{,/**}",
      "!input{,/**}",
      "!output{,/**}",
      "!secrets{,/**}",
      "!.auth{,/**}",
      "!.desktop-app{,/**}",
      "!dist/apps/desktop-tauri{,/**}"
    ],
    "extraResources": [
      {
        "from": "dist/apps/chrome-extension",
        "to": "chrome-extension",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": ".playwright-browsers",
        "to": "playwright-runtime",
        "filter": [
          "**/*"
        ]
      }
    ],
    "extraFiles": [
      {
        "from": "install-chrome-extension-helper.bat",
        "to": "install-chrome-extension-helper.bat"
      }
    ],
    "asarUnpack": [
      "node_modules/playwright/**/*",
      "node_modules/playwright-core/**/*"
    ],
    "win": {
      "icon": "apps/desktop-electron/resources/wishfigure-icon.ico",
      "verifyUpdateCodeSignature": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "WishfigureSellerDesk-Setup-${version}.${ext}",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Wishfigure Seller Desk"
    },
    "afterPack": "scripts/embed-app-icon.cjs"
  }
}
