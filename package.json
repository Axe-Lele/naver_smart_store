{
  "name": "smart-store",
  "version": "1.0.0",
  "description": "CLI automation for classifying and converting Smart Store preorder products via the seller center UI.",
  "main": "dist/apps/desktop-electron/main/main.cjs",
  "type": "module",
  "private": true,
  "scripts": {
    "login:prepare": "tsx src/cli/login-prepare.ts",
    "poc": "tsx src/cli/poc.ts",
    "run": "tsx src/cli/run.ts",
    "desktop:dev": "set \"ELECTRON_RUN_AS_NODE=\" && electron-vite dev --config apps/desktop-electron/electron.vite.config.ts",
    "desktop:build": "set \"ELECTRON_RUN_AS_NODE=\" && electron-vite build --config apps/desktop-electron/electron.vite.config.ts",
    "desktop:preview": "set \"ELECTRON_RUN_AS_NODE=\" && electron-vite preview --config apps/desktop-electron/electron.vite.config.ts",
    "desktop:prepare-runtime": "node scripts/prepare-playwright-runtime.mjs",
    "desktop:dist": "npm run desktop:prepare-runtime && npm run desktop:build && electron-builder --win nsis",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run test"
  },
  "keywords": [
    "playwright",
    "typescript",
    "cli",
    "smartstore"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "commander": "^14.0.1",
    "dotenv": "^17.2.3",
    "fast-csv": "^5.0.5",
    "pino": "^10.0.0",
    "playwright": "^1.56.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^41.2.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vite": "^7.3.2",
    "vitest": "^4.1.3"
  },
  "build": {
    "appId": "com.smartstore.desktopoperator",
    "productName": "Smart Store Desktop Operator",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/apps/desktop-electron/**/*",
      "package.json",
      "node_modules/**/*",
      "!apps{,/**}",
      "!packages{,/**}",
      "!src{,/**}",
      "!tests{,/**}",
      "!input{,/**}",
      "!output{,/**}",
      "!secrets{,/**}",
      "!.auth{,/**}",
      "!.desktop-app{,/**}",
      "!dist/apps/desktop-tauri{,/**}"
    ],
    "extraResources": [
      {
        "from": ".playwright-browsers",
        "to": "playwright-runtime",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asarUnpack": [
      "node_modules/playwright/**/*",
      "node_modules/playwright-core/**/*"
    ],
    "win": {
      "signAndEditExecutable": false,
      "verifyUpdateCodeSignature": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "SmartStoreDesktopOperator-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Smart Store Desktop Operator"
    }
  }
}
