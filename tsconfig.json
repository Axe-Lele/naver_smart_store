{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "ignoreDeprecations": "6.0",
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@smart-store/core": ["packages/core/src/index.ts"],
      "@smart-store/core/*": ["packages/core/src/*"],
      "@smart-store/application": ["packages/application/src/index.ts"],
      "@smart-store/application/*": ["packages/application/src/*"],
      "@smart-store/shared": ["packages/shared/src/index.ts"],
      "@smart-store/shared/*": ["packages/shared/src/*"],
      "@smart-store/infrastructure-playwright": [
        "packages/infrastructure-playwright/src/index.ts"
      ],
      "@smart-store/infrastructure-playwright/*": [
        "packages/infrastructure-playwright/src/*"
      ]
    },
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"]
  },
  "include": [
    "src/**/*.ts",
    "tests/**/*.ts",
    "packages/**/*.ts",
    "packages/**/*.tsx",
    "apps/**/*.ts",
    "apps/**/*.tsx"
  ]
}
